{
  "manifest_version": 3,
  "name": "MediaGrab Edge Bridge",
  "version": "0.8.2",
  "description": "Share your current YouTube session with MediaGrab on this computer when downloading.",
  "key": "",
  "permissions": [
    "cookies",
    "nativeMessaging",
    "storage",
    "alarms"
  ],
  "host_permissions": [
    "https://*.youtube.com/*",
    "https://*.google.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html"
  },
  "incognito": "not_allowed"
}